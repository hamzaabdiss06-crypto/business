# Public/runtime configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Firebase Admin - prefer workload identity / application default credentials in production
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini - server-side only
GEMINI_API_KEY=

# M-Pesa Daraja - server-side only
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox

# SMS provider - server-side only
SMS_API_KEY=
SMS_SENDER_ID=
